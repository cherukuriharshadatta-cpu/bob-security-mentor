# Copy these placeholder values into the environment of the server process.
# This file contains no credential and is not loaded automatically.
# Never put a real key or a shared key in the browser/client code.
BOB_WEB_PORT=4173
BOB_DATA_DIR=.bob
# The direct extension proxy uses BOB_PORT instead of BOB_WEB_PORT.
BOB_PORT=8787
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
